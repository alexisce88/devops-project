---
# Jenkins Configuration as Code (JCasC)
# Deployed to /var/lib/jenkins/casc_configs/jenkins.yaml

jenkins:
  systemMessage: "DevOps Capstone - Jenkins CI/CD Server (configured via JCasC)"
  numExecutors: 4
  mode: NORMAL

  securityRealm:
    local:
      allowsSignup: false
      users:
        - id: "admin"
          password: "${JENKINS_ADMIN_PASSWORD}"

  authorizationStrategy:
    loggedInUsersCanDoAnything:
      allowAnonymousRead: false

  globalNodeProperties:
    - envVars:
        env:
          - key: REGISTRY
            value: "ghcr.io/alexisce88"

credentials:
  system:
    domainCredentials:
      - credentials:
          - string:
              scope: GLOBAL
              id: "github-token"
              description: "GitHub Personal Access Token"
              secret: "${GITHUB_TOKEN}"
          - usernamePassword:
              scope: GLOBAL
              id: "ghcr-creds"
              description: "GHCR Docker Registry Credentials"
              username: "alexisce88"
              password: "${GITHUB_TOKEN}"
          - basicSSHUserPrivateKey:
              scope: GLOBAL
              id: "ec2-ssh-key"
              description: "EC2 SSH Private Key for Ansible"
              username: "ubuntu"
              privateKeySource:
                directEntry:
                  privateKey: "${EC2_SSH_KEY}"
          - string:
              scope: GLOBAL
              id: "staging-server-ip"
              description: "Staging Server IP"
              secret: "${STAGING_IP}"
          - string:
              scope: GLOBAL
              id: "blue-server-ip"
              description: "Blue Production Server IP"
              secret: "${BLUE_IP}"
          - string:
              scope: GLOBAL
              id: "green-server-ip"
              description: "Green Production Server IP"
              secret: "${GREEN_IP}"
          - string:
              scope: GLOBAL
              id: "nginx-server-ip"
              description: "Nginx/Jenkins Server IP"
              secret: "${NGINX_IP}"

unclassified:
  gitHubPluginConfig:
    configs:
      - name: "GitHub"
        apiUrl: "https://api.github.com"
        credentialsId: "github-token"
        manageHooks: true
  location:
    url: "http://{{ ansible_host }}:8080/"
    adminAddress: "admin@devops-capstone.local"

tool:
  git:
    installations:
      - name: Default
        home: git
