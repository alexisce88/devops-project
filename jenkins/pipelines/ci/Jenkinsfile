// ============================================================
// Pipeline 1: CI — Lint + Test
// Triggers: GitHub webhook on every PR / push
// ============================================================
@Library('devops-shared-library') _

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timeout(time: 20, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        REGISTRY = 'ghcr.io/alexisce88'
        SHORT_SHA = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
    }

    stages {
        stage('Notify: Pending') {
            steps {
                notifyGitHub(state: 'pending', description: 'CI started', context: 'ci/lint-test')
            }
        }

        stage('Backend: Lint') {
            steps {
                dir('app/backend') {
                    sh 'npm ci'
                    sh 'npm run lint'
                }
            }
        }

        stage('Backend: Test') {
            steps {
                dir('app/backend') {
                    sh 'npm run test:coverage'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'app/backend/coverage/junit.xml'
                }
            }
        }

        stage('Frontend: Lint') {
            steps {
                dir('app/frontend') {
                    sh 'npm ci'
                    sh 'npm run lint'
                }
            }
        }

        stage('Frontend: Test') {
            steps {
                dir('app/frontend') {
                    sh 'npm test'
                }
            }
        }

        stage('Docker: Validate Builds') {
            steps {
                sh '''
                    docker build --no-cache -t ci-backend-test app/backend
                    docker build --no-cache -t ci-frontend-test app/frontend
                    docker rmi ci-backend-test ci-frontend-test
                '''
            }
        }
    }

    post {
        success {
            notifyGitHub(
                state: 'success',
                description: 'All checks passed',
                context: 'ci/lint-test',
                prComment: true
            )
        }
        failure {
            notifyGitHub(
                state: 'failure',
                description: 'CI failed — check build logs',
                context: 'ci/lint-test',
                prComment: true
            )
        }
        always {
            cleanWs()
        }
    }
}
