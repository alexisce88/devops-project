// ============================================================
// Pipeline 3: Production — Blue/Green Deployment + Rollback
// Triggers: Manual dispatch OR Alertmanager webhook (ROLLBACK=true)
// ============================================================
@Library('devops-shared-library') _

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timeout(time: 45, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: 'latest',
            description: 'Docker image tag to deploy (git short SHA or "latest")'
        )
        booleanParam(
            name: 'ROLLBACK',
            defaultValue: false,
            description: 'Set to true to trigger emergency rollback to previously active slot'
        )
    }

    environment {
        REGISTRY       = 'ghcr.io/alexisce88'
        BACKEND_IMAGE  = "${REGISTRY}/devops-backend"
        FRONTEND_IMAGE = "${REGISTRY}/devops-frontend"
        STATE_FILE     = '/var/lib/jenkins/bluegreen_state'
    }

    stages {
        stage('Read Blue/Green State') {
            steps {
                script {
                    env.ACTIVE_SLOT = sh(
                        script: "cat ${STATE_FILE} 2>/dev/null || echo 'blue'",
                        returnStdout: true
                    ).trim()
                    env.IDLE_SLOT = env.ACTIVE_SLOT == 'blue' ? 'green' : 'blue'

                    echo "Current ACTIVE slot : ${env.ACTIVE_SLOT}"
                    echo "Deploying to IDLE   : ${env.IDLE_SLOT}"
                }
            }
        }

        stage('Emergency Rollback') {
            when {
                expression { params.ROLLBACK == true }
            }
            steps {
                withCredentials([
                    string(credentialsId: 'nginx-server-ip', variable: 'NGINX_IP'),
                    string(credentialsId: 'blue-server-ip', variable: 'BLUE_IP'),
                    string(credentialsId: 'green-server-ip', variable: 'GREEN_IP'),
                    string(credentialsId: 'staging-server-ip', variable: 'STAGING_IP'),
                    sshUserPrivateKey(credentialsId: 'ec2-ssh-key', keyFileVariable: 'SSH_KEY')
                ]) {
                    echo "ROLLBACK triggered — switching Nginx back to ACTIVE slot: ${env.ACTIVE_SLOT}"
                    sh """
                        ansible-playbook ansible/playbooks/switch_nginx.yml \\
                          --private-key=\${SSH_KEY} \\
                          -i \${NGINX_IP}, \\
                          -e "target_slot=${env.ACTIVE_SLOT}" \\
                          -e "blue_ip=\${BLUE_IP}" \\
                          -e "green_ip=\${GREEN_IP}" \\
                          -e "staging_ip=\${STAGING_IP}"
                    """
                }
                script {
                    currentBuild.result = 'ABORTED'
                    error("Rollback to '${env.ACTIVE_SLOT}' complete. Pipeline halted.")
                }
            }
        }

        stage('Deploy to Idle Slot') {
            when {
                expression { params.ROLLBACK == false }
            }
            steps {
                withCredentials([
                    string(credentialsId: "${env.IDLE_SLOT}-server-ip", variable: 'TARGET_IP'),
                    string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN'),
                    sshUserPrivateKey(credentialsId: 'ec2-ssh-key', keyFileVariable: 'SSH_KEY')
                ]) {
                    sh """
                        ansible-playbook ansible/playbooks/deploy_production.yml \\
                          --private-key=\${SSH_KEY} \\
                          -i \${TARGET_IP}, \\
                          -e "target_slot=${env.IDLE_SLOT}" \\
                          -e "frontend_image=${FRONTEND_IMAGE}:${params.IMAGE_TAG}" \\
                          -e "backend_image=${BACKEND_IMAGE}:${params.IMAGE_TAG}" \\
                          -e "ghcr_username=alexisce88" \\
                          -e "ghcr_token=\${GITHUB_TOKEN}" \\
                          -e "db_password=\${PROD_DB_PASSWORD:-prodpass456}"
                    """
                }
            }
        }

        stage('Smoke Test Idle Slot') {
            when {
                expression { params.ROLLBACK == false }
            }
            steps {
                withCredentials([
                    string(credentialsId: "${env.IDLE_SLOT}-server-ip", variable: 'TARGET_IP')
                ]) {
                    script {
                        runHealthCheck(
                            url: "http://${TARGET_IP}:3001/health",
                            label: "Idle slot (${env.IDLE_SLOT}) /health",
                            retries: 18,
                            delay: 10
                        )
                        runHealthCheck(
                            url: "http://${TARGET_IP}:3001/status",
                            label: "Idle slot (${env.IDLE_SLOT}) /status"
                        )
                        runHealthCheck(
                            url: "http://${TARGET_IP}:3000",
                            label: "Idle slot (${env.IDLE_SLOT}) frontend"
                        )
                    }
                }
            }
        }

        stage('Switch Traffic (Nginx)') {
            when {
                expression { params.ROLLBACK == false }
            }
            steps {
                withCredentials([
                    string(credentialsId: 'nginx-server-ip', variable: 'NGINX_IP'),
                    string(credentialsId: 'blue-server-ip', variable: 'BLUE_IP'),
                    string(credentialsId: 'green-server-ip', variable: 'GREEN_IP'),
                    string(credentialsId: 'staging-server-ip', variable: 'STAGING_IP'),
                    sshUserPrivateKey(credentialsId: 'ec2-ssh-key', keyFileVariable: 'SSH_KEY')
                ]) {
                    sh """
                        ansible-playbook ansible/playbooks/switch_nginx.yml \\
                          --private-key=\${SSH_KEY} \\
                          -i \${NGINX_IP}, \\
                          -e "target_slot=${env.IDLE_SLOT}" \\
                          -e "blue_ip=\${BLUE_IP}" \\
                          -e "green_ip=\${GREEN_IP}" \\
                          -e "staging_ip=\${STAGING_IP}"
                    """
                    echo "Traffic switched to: ${env.IDLE_SLOT}"
                }
            }
        }

        stage('Monitor (10-minute window)') {
            when {
                expression { params.ROLLBACK == false }
            }
            steps {
                withCredentials([
                    string(credentialsId: 'nginx-server-ip', variable: 'NGINX_IP'),
                    string(credentialsId: 'nginx-server-ip', variable: 'NGINX_IP'),
                    string(credentialsId: 'blue-server-ip', variable: 'BLUE_IP'),
                    string(credentialsId: 'green-server-ip', variable: 'GREEN_IP'),
                    string(credentialsId: 'staging-server-ip', variable: 'STAGING_IP'),
                    sshUserPrivateKey(credentialsId: 'ec2-ssh-key', keyFileVariable: 'SSH_KEY')
                ]) {
                    script {
                        def deadline = System.currentTimeMillis() + (10 * 60 * 1000)
                        def rollbackTriggered = false

                        echo "Starting 10-minute monitoring window..."

                        while (System.currentTimeMillis() < deadline) {
                            def httpCode = sh(
                                script: "curl -s -o /dev/null -w '%{http_code}' --connect-timeout 5 'http://${NGINX_IP}/health'",
                                returnStdout: true
                            ).trim()

                            if (httpCode != '200') {
                                echo "Health check failed: HTTP ${httpCode}. Initiating auto-rollback to ${env.ACTIVE_SLOT}..."

                                sh """
                                    ansible-playbook ansible/playbooks/switch_nginx.yml \\
                                      --private-key=\${SSH_KEY} \\
                                      -i \${NGINX_IP}, \\
                                      -e "target_slot=${env.ACTIVE_SLOT}" \\
                                      -e "blue_ip=\${BLUE_IP}" \\
                                      -e "green_ip=\${GREEN_IP}" \\
                                      -e "staging_ip=\${STAGING_IP}"
                                """

                                rollbackTriggered = true
                                error("Auto-rollback to '${env.ACTIVE_SLOT}' triggered (HTTP ${httpCode})")
                            }

                            def remaining = ((deadline - System.currentTimeMillis()) / 1000 / 60).toInteger()
                            echo "OK (HTTP ${httpCode}) — ${remaining} minutes remaining in monitoring window"
                            sleep(30)
                        }

                        if (!rollbackTriggered) {
                            echo "Monitoring window completed successfully. Saving new state."
                            sh "echo '${env.IDLE_SLOT}' > ${STATE_FILE}"
                            echo "State file updated: ACTIVE slot is now '${env.IDLE_SLOT}'"
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Production deployment complete. ACTIVE slot: ${env.IDLE_SLOT}"
        }
        failure {
            echo "Production pipeline FAILED or rolled back. ACTIVE slot remains: ${env.ACTIVE_SLOT}"
        }
        always {
            cleanWs()
        }
    }
}
